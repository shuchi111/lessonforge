# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Writer writes and revises the lesson. Judge evaluates it.
# Using a different model family for the judge reduces "grading your own homework" bias.
WRITER_MODEL=qwen/qwen3.8-27b
JUDGE_MODEL=openai/gpt-oss-120b
REFLECTOR_MODEL=qwen/qwen3.8-27b

# Client-side tokens-per-minute budget per model (match your Groq tier limits).
WRITER_TPM=8000
JUDGE_TPM=8000

# Loop settings
MAX_RETRIES=2
